{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "name": {
      "type": "string"
    },
    "designation": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "linkedInProfile": {
      "type": "string",
      "regex": "^https?://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
    }
  }
}
