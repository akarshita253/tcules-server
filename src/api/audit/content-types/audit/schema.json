{
  "kind": "collectionType",
  "collectionName": "audits",
  "info": {
    "singularName": "audit",
    "pluralName": "audits",
    "displayName": "Audit",
    "description": "Flexible audit and assessment pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "hero": {
      "type": "component",
      "component": "audit.hero",
      "repeatable": false,
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "required": true,
      "components": [
        "audit.section-heading",
        "audit.rich-text",
        "audit.card-grid",
        "audit.comparison-cards",
        "audit.table",
        "audit.quote",
        "audit.callout",
        "audit.labelled-list",
        "audit.two-column-content",
        "audit.link-group",
        "shared.media"
      ]
    },
    "faqSection": {
      "type": "component",
      "component": "shared.faq-section",
      "repeatable": false
    },
    "capabilitiesCta": {
      "type": "component",
      "component": "service.hero-section",
      "repeatable": false,
      "required": true
    },
    "cta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
