{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Flexible service pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "hero": {
      "type": "component",
      "component": "service.hero",
      "repeatable": false,
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "required": true,
      "components": [
        "service.section-heading",
        "service.rich-text",
        "service.card-grid",
        "service.comparison-cards",
        "service.table",
        "service.quote",
        "service.callout",
        "service.labelled-list",
        "service.two-column-content",
        "service.link-group",
        "shared.media"
      ]
    },
    "faqSection": {
      "type": "component",
      "component": "shared.faq-section",
      "repeatable": false
    },
    "capabilitiesCta": {
      "type": "component",
      "component": "service.hero-section",
      "repeatable": false,
      "required": true
    },
    "cta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
