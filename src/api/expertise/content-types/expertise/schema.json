{
  "kind": "collectionType",
  "collectionName": "expertises",
  "info": {
    "singularName": "expertise",
    "pluralName": "expertises",
    "displayName": "Expertise",
    "description": "Flexible expertise pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "expertise.hero",
      "repeatable": false,
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "required": true,
      "components": [
        "expertise.section-heading",
        "expertise.rich-text",
        "expertise.card-grid",
        "expertise.comparison-cards",
        "expertise.table",
        "expertise.quote",
        "expertise.callout",
        "expertise.labelled-list",
        "expertise.two-column-content",
        "expertise.link-group",
        "shared.media"
      ]
    },
    "faqSection": {
      "type": "component",
      "component": "shared.faq-section",
      "repeatable": false
    },
    "capabilitiesCta": {
      "type": "component",
      "component": "service.hero-section",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
